{
  "name": "@web-agent/react",
  "version": "0.1.0",
  "description": "React hooks and components for browser-based AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks/use-agent": {
      "types": "./dist/hooks/use-agent.d.ts",
      "import": "./dist/hooks/use-agent.js"
    },
    "./hooks/use-agent-stream": {
      "types": "./dist/hooks/use-agent-stream.d.ts",
      "import": "./dist/hooks/use-agent-stream.js"
    },
    "./components/AgentChat": {
      "types": "./dist/components/AgentChat.d.ts",
      "import": "./dist/components/AgentChat.js"
    },
    "./components/A2UComponent": {
      "types": "./dist/components/A2UComponent.d.ts",
      "import": "./dist/components/A2UComponent.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "dependencies": {
    "@mediapipe/tasks-genai": "^0.10.14",
    "@web-agent/ui-protocol": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "jsdom": "^24.0.0"
  },
  "peerDependencies": {
    "@web-agent/core": "workspace:^0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "react",
    "hooks",
    "web-agent",
    "browser"
  ],
  "license": "MIT"
}

