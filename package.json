{
  "name": "web-agent-framework",
  "version": "0.1.0",
  "description": "Client-side web agent orchestration framework for browser-based LLMs",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
